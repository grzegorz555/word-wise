<Project>
  <!-- Central Package Management: package versions live here, csproj files only reference names.
       Docs: https://learn.microsoft.com/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Pinned explicitly: the transitive 2.0.0 has a known vulnerability (GHSA-v5pm-xwqc-g5wc). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- Only the UI: the OpenAPI document itself is generated by Microsoft.AspNetCore.OpenApi (ADR-0009). -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- Writes the OpenAPI document at build time, for the generated Angular client (ADR-0012). -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <!-- EF Core with the PostgreSQL provider (ADR-0003). Design = tooling for `dotnet ef` (migrations, T3). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- Pinned explicitly: Npgsql brings EF Core 10.0.4 and Design brings 10.0.12; one version for every project (MSB3277). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- xUnit v3 runs on Microsoft.Testing.Platform (see "test.runner" in global.json). -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>

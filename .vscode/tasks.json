{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs before "API: launch (http)" in launch.json.
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/api/WordWise.Api/WordWise.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/api/WordWise.Api/WordWise.Api.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}

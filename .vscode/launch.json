{
  // Debugging the API in VS Code / Cursor (docs/how-to/run-locally.md, "Debugging the API").
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: launch (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/api/WordWise.Api/bin/Debug/net10.0/WordWise.Api.dll",
      "cwd": "${workspaceFolder}/src/api/WordWise.Api",
      "stopAtEntry": false,
      // Same environment and URL as the "http" profile in Properties/launchSettings.json.
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5033",
        "Seed__RunAtStartup": "true"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      // For an API already started with `dotnet run`: pick the WordWise.Api process.
      "name": "API: attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      // Debugs API tests: an xUnit v3 test project is an executable, so the debugger starts it directly.
      // Started directly, it uses the xUnit console options (-method), not the `dotnet test` ones (--filter-method).
      // The filter limits the run to the tests you care about (e.g. *Parse_SingleValidRow*).
      "name": "API tests: debug (filter)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api-tests",
      "program": "${workspaceFolder}/tests/WordWise.Api.Tests/bin/Debug/net10.0/WordWise.Api.Tests.dll",
      "args": ["-method", "${input:testMethodFilter}"],
      "cwd": "${workspaceFolder}/tests/WordWise.Api.Tests",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "testMethodFilter",
      "type": "promptString",
      "description": "Test method filter (* = any text)",
      "default": "*Parse_SingleValidRow*"
    }
  ]
}

{
  "name": "wordwise-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:spec": "dotnet build ../api/WordWise.Api/WordWise.Api.csproj",
    "api:gen": "ng-openapi-gen && prettier --write --log-level warn src/app/core/api",

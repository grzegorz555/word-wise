{
  "openapi": "3.1.1",
  "info": {
    "title": "WordWise.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/words/cards": {
      "get": {
        "tags": [
          "Words"
        ],
        "operationId": "GetWordCards",
        "parameters": [
          {
            "name": "base",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "en",
                "pl",
                "tr"
              ],
              "type": "string"
            }
          },
          {
            "name": "target",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "en",
                "pl",
                "tr"
              ],
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "default": "sequential",
              "$ref": "#/components/schemas/CardOrder"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WordCardResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CardOrder": {
        "enum": [
          "sequential",
          "random"
        ]
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "WordCardResponse": {
        "required": [
          "wordId",
          "text",
          "rank",
          "partOfSpeech",
          "translations"
        ],
        "type": "object",
        "properties": {
          "wordId": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "format": "int32"
          },
          "partOfSpeech": {
            "type": "string"
          },
          "translations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Words"
    }
  ]
}
# Flashcards for a Polish speaker learning Turkish (spec 001).
# 200 with cards sorted by rank once TODO(human) #1 and #2 are done; until then 500 (NotImplementedException).
GET {{WordWise.Api_HostAddress}}/api/words/cards?base=pl&target=tr&order=sequential
Accept: application/json

